<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Text appearances -->
    <style name="AppTitle">
        <item name="android:textSize">38sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/colorPrimary</item>
    </style>

    <style name="AppSubtitle">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/colorOnSurfaceMuted</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="AppSectionTitle">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/colorOnSurface</item>
    </style>

    <style name="AppBody">
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/colorOnSurface</item>
    </style>

    <style name="AppCaption">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/colorOnSurfaceMuted</item>
    </style>

    <style name="AppBadge">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/colorSuccess</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Widgets -->
    <style name="SurfaceCard">
        <item name="android:background">@drawable/bg_card_surface</item>
    </style>

    <style name="MutedCard">
        <item name="android:background">@drawable/bg_card_muted</item>
    </style>

    <style name="PrimaryButton">
        <item name="android:background">@drawable/btn_vista_style</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">220dp</item>
        <item name="android:elevation">4dp</item>
    </style>

</resources>